{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/landings/papa-primerizo/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/landings/papa-primerizo/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/landings/papa-primerizo/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/landings/papa-primerizo/doclevel-logo.png",
      "destination": "/doclevel-logo.png"
    },
    {
      "source": "/landings/papa-primerizo/doctor-papa-primerizo.png",
      "destination": "/doctor-papa-primerizo.png"
    },
    {
      "source": "/landings/papa-primerizo",
      "destination": "/index.html"
    },
    {
      "source": "/landings/papa-primerizo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/medicos-docentes",
      "destination": "/index.html"
    },
    {
      "source": "/medicos-docentes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}