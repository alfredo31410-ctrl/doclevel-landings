{
  "rewrites": [
    {
      "source": "/papa-primerizo/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/papa-primerizo/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/papa-primerizo/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/papa-primerizo/doclevel-logo.png",
      "destination": "/doclevel-logo.png"
    },
    {
      "source": "/papa-primerizo/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
