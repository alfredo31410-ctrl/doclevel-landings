{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/landings/papa-primerizo/gracias",
      "destination": "/landings/las-primeras-hrs-de-tu-bebe/gracias",
      "permanent": true
    },
    {
      "source": "/landings/papa-primerizo",
      "destination": "/landings/las-primeras-hrs-de-tu-bebe",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/landings/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/landings/papa-primerizo/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/landings/papa-primerizo/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/landings/papa-primerizo/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/landings/papa-primerizo/doclevel-logo.png",
      "destination": "/doclevel-logo.png"
    },
    {
      "source": "/landings/papa-primerizo/doctor-papa-primerizo.png",
      "destination": "/doctor-papa-primerizo.png"
    },
    {
      "source": "/landings/las-primeras-hrs-de-tu-bebe",
      "destination": "/index.html"
    },
    {
      "source": "/landings/las-primeras-hrs-de-tu-bebe/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/landings/medicos-docentes",
      "destination": "/index.html"
    },
    {
      "source": "/landings/ENARM",
      "destination": "/index.html"
    },
    {
      "source": "/landings/ENARM/gracias",
      "destination": "/index.html"
    },
    {
      "source": "/landings/ENARM/unirse-whatsapp",
      "destination": "/index.html"
    },
    {
      "source": "/landings/medicos-docentes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/medicos-docentes",
      "destination": "/index.html"
    },
    {
      "source": "/medicos-docentes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/landings/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
