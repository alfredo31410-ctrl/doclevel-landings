:root {
  color: #171717;
  background: #f7f3ec;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button,
a {
  color: inherit;
  font: inherit;
}

a {
  text-decoration: none;
}

.single-screen {
  align-items: center;
  display: flex;
  height: 100dvh;
  overflow: hidden;
  padding: clamp(10px, 1.8vw, 24px);
}

.register-screen {
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.86), rgba(255, 242, 218, 0.66)),
    #f6eee2;
}

.landing-shell {
  align-items: stretch;
  display: grid;
  gap: clamp(12px, 2.2vw, 28px);
  grid-template-columns: minmax(0, 1.02fr) minmax(300px, 0.98fr);
  height: min(720px, 100%);
  margin: 0 auto;
  max-width: 1360px;
  width: 100%;
}

.copy-column,
.image-column,
.thanks-shell,
.modal {
  border-radius: 8px;
}

.copy-column {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: clamp(12px, 2.8vw, 34px);
}

.brand {
  align-items: center;
  display: inline-flex;
  font-weight: 900;
  gap: 10px;
  margin-bottom: clamp(12px, 2vh, 22px);
  width: fit-content;
}

.brand-mark {
  align-items: center;
  background: #22322d;
  border-radius: 8px;
  color: #ffffff;
  display: inline-flex;
  height: 38px;
  justify-content: center;
  width: 38px;
}

.message-box {
  align-items: center;
  background: #fff7df;
  border: 2px solid #f0b429;
  border-radius: 8px;
  color: #2f2614;
  display: grid;
  gap: 8px 12px;
  grid-template-columns: auto minmax(120px, auto) 1fr;
  margin-bottom: clamp(12px, 2vh, 22px);
  padding: clamp(10px, 1.4vw, 14px) clamp(12px, 1.7vw, 18px);
}

.message-box svg {
  color: #c77800;
  height: 24px;
  width: 24px;
}

.message-box strong {
  font-weight: 950;
}

.message-box span {
  color: #5f5134;
  font-size: 0.96rem;
  line-height: 1.35;
}

.eyebrow {
  color: #bb3f15;
  font-size: 0.82rem;
  font-weight: 950;
  letter-spacing: 0;
  margin: 0 0 10px;
  text-transform: uppercase;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  color: #161b18;
  font-size: clamp(2.35rem, 5.2vw, 4.95rem);
  line-height: 0.98;
  letter-spacing: 0;
  margin-bottom: clamp(14px, 2vh, 22px);
  max-width: 780px;
}

h2 {
  color: #161b18;
  font-size: clamp(1.45rem, 2.5vw, 2.1rem);
  line-height: 1.08;
  margin-bottom: 16px;
}

.lead {
  color: #534d43;
  font-size: clamp(0.98rem, 1.45vw, 1.18rem);
  line-height: 1.42;
  margin-bottom: clamp(18px, 3vh, 28px);
  max-width: 690px;
}

.primary-button {
  align-items: center;
  background: #f04e23;
  border: 0;
  border-radius: 8px;
  box-shadow: 0 20px 38px rgba(240, 78, 35, 0.34);
  color: #ffffff;
  cursor: pointer;
  display: inline-flex;
  font-weight: 950;
  gap: 10px;
  justify-content: center;
  min-height: 58px;
  padding: 15px 28px;
  width: fit-content;
}

.primary-button svg {
  height: 22px;
  width: 22px;
}

.pulse-button {
  animation: buttonPulse 1.9s ease-in-out infinite;
}

.image-column {
  align-items: stretch;
  background:
    linear-gradient(145deg, rgba(34, 50, 45, 0.06), rgba(240, 78, 35, 0.13)),
    #ffffff;
  border: 1px dashed #c8bdaa;
  display: flex;
  min-height: 0;
  overflow: hidden;
  padding: clamp(10px, 1.8vw, 20px);
  position: relative;
}

.image-column::before {
  background: #f04e23;
  content: "";
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  transform: skewX(-10deg) translateX(-82%);
  width: 46%;
}

.image-placeholder {
  align-items: center;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(255, 245, 229, 0.9)),
    #fbf1df;
  border-radius: 8px;
  color: #5f5134;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-height: 100%;
  padding: 24px;
  position: relative;
  text-align: center;
}

.image-placeholder span {
  color: #bb3f15;
  font-size: 0.86rem;
  font-weight: 950;
  margin-bottom: 10px;
  text-transform: uppercase;
}

.image-placeholder strong {
  color: #25251f;
  font-size: clamp(1.55rem, 3.3vw, 2.9rem);
  line-height: 1;
  max-width: 360px;
}

.modal-backdrop {
  align-items: center;
  background: rgba(18, 20, 18, 0.72);
  display: flex;
  inset: 0;
  justify-content: center;
  padding: 18px;
  position: fixed;
  z-index: 40;
}

.modal {
  background: #ffffff;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  max-height: min(720px, calc(100dvh - 36px));
  max-width: 620px;
  overflow: auto;
  padding: clamp(22px, 4vw, 36px);
  position: relative;
  width: min(100%, 620px);
}

.modal-close {
  align-items: center;
  background: #f4eee5;
  border: 0;
  border-radius: 8px;
  color: #251f18;
  cursor: pointer;
  display: inline-flex;
  height: 42px;
  justify-content: center;
  position: absolute;
  right: 16px;
  top: 16px;
  width: 42px;
}

.modal-close svg {
  height: 20px;
  width: 20px;
}

.active-campaign-embed {
  min-height: 220px;
}

.thanks-screen {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.84), rgba(225, 248, 231, 0.72)),
    #eef8ef;
  justify-content: center;
  text-align: center;
}

.thanks-shell {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 880px;
  padding: clamp(16px, 4vw, 42px);
}

.centered-brand {
  margin-inline: auto;
}

.whatsapp {
  background: #13a85b;
  box-shadow: 0 20px 38px rgba(19, 168, 91, 0.32);
}

.progress-card {
  background: #ffffff;
  border: 1px solid rgba(19, 168, 91, 0.22);
  border-radius: 8px;
  box-shadow: 0 16px 34px rgba(22, 49, 31, 0.08);
  margin-bottom: clamp(16px, 3vh, 26px);
  max-width: 520px;
  padding: 14px;
  width: min(100%, 520px);
}

.progress-label {
  align-items: center;
  color: #2e3b33;
  display: flex;
  font-size: 0.94rem;
  font-weight: 850;
  justify-content: space-between;
  margin-bottom: 10px;
}

.progress-label strong {
  color: #13a85b;
  font-size: 1.1rem;
}

.progress-track {
  background: #dcebe1;
  border-radius: 999px;
  height: 13px;
  overflow: hidden;
}

.progress-fill {
  background: linear-gradient(90deg, #13a85b, #f0b429);
  border-radius: inherit;
  display: block;
  height: 100%;
  width: 80%;
}

@keyframes buttonPulse {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }

  50% {
    transform: translateY(-2px) scale(1.03);
  }
}

@media (max-width: 820px) {
  .single-screen {
    padding: 8px;
  }

  .landing-shell {
    grid-template-columns: 1fr;
    grid-template-rows: minmax(0, 1fr) minmax(104px, 0.34fr);
    height: 100%;
  }

  .copy-column {
    padding: 10px;
  }

  .brand {
    margin-bottom: 12px;
  }

  .message-box {
    grid-template-columns: auto 1fr;
    margin-bottom: 10px;
    padding: 10px;
  }

  .message-box span {
    grid-column: 1 / -1;
  }

  h1 {
    font-size: clamp(1.82rem, 9.5vw, 2.9rem);
  }

  .lead {
    font-size: 0.94rem;
    line-height: 1.32;
    margin-bottom: 14px;
  }

  .primary-button {
    min-height: 56px;
    width: 100%;
  }

  .image-column {
    min-height: 104px;
    padding: 8px;
  }

  .image-placeholder strong {
    font-size: clamp(1.4rem, 7vw, 2.3rem);
  }
}

@media (max-height: 650px) and (min-width: 821px) {
  h1 {
    font-size: clamp(2.15rem, 4.4vw, 3.75rem);
  }

  .lead {
    font-size: 0.96rem;
    line-height: 1.3;
  }

  .message-box {
    margin-bottom: 12px;
  }

  .primary-button {
    min-height: 52px;
  }
}

@media (max-height: 560px) {
  .brand-mark {
    height: 32px;
    width: 32px;
  }

  .brand {
    margin-bottom: 8px;
  }

  .message-box span,
  .lead {
    font-size: 0.88rem;
  }

  .primary-button {
    min-height: 48px;
    padding-block: 12px;
  }
}
